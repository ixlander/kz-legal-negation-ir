# env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# raw data: large / third-party, not versioned
data/raw/
# teacher folder contained a notebook with a live HF token — never commit it
app.py
llama2 notebook.ipynb

# model checkpoints
checkpoints/
*.pt
*.safetensors

# third-party datasets (gated / licensed), downloaded by src/data/fetch_external.py
data/external/

# retrieval indexes (embeddings, tokenized corpora): rebuilt by src/retrieval/*
data/index/

# NLI subsets of third-party datasets (rebuilt from data/external by the NLI data builder)
data/nli/xnli_*.jsonl
data/nli/snli_kk.jsonl
data/nli/kardes_kk_*.jsonl
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.fls
docs/paper/*.fdb_latexmk
docs/paper/*.xdv
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.out

# third-party papers (copyrighted PDFs): kept locally, listed in docs/papers/README.md
docs/papers/*.pdf

# generated review pages and their data (rebuilt by tools/review/build_*.py)
tools/review/review_page.html
tools/review/review_data.json
tools/review/review_v2_*.html

# local snapshots of the annotation store
data/review/snapshot_*/

# training logs and report build files
logs/
docs/report/*.aux
docs/report/*.log
docs/report/*.fls
docs/report/*.fdb_latexmk
docs/report/*.xdv
docs/report/*.bbl
docs/report/*.blg
docs/report/*.out
